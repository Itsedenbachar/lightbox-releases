    <item>
      <title>Moodlib 0.5.0</title>
      <pubDate>Tue, 10 Nov 2026 10:20:25 +0100</pubDate>
      <sparkle:version>166</sparkle:version>
      <sparkle:shortVersionString>0.5.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>A quick tour for new users (replay it from Help &gt; Moodlib Tour). A new app icon and a clearer Import button. ShotDeck pictures come into the library at full size, and FrameSet frames dropped on a board fill in with the full picture. Site logins in the browser stay on their own site.</p>]]></description>
